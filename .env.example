# ===== Render Environment Variables Reference =====
#
# ---- Backend (Python Web Service) ----
# PYTHONPATH=/opt/render/project/src
# MODEL_PATH=yolov8n.pt
# PYTHONUNBUFFERED=1
# CORS_ORIGINS=https://your-frontend.onrender.com   (optional, defaults to *)
# CONFIDENCE_THRESHOLD=0.25                        (optional)
# INPUT_SIZE=640                                   (optional)
#
# ---- Frontend (Static Site) ----
# VITE_API_URL=https://your-backend.onrender.com
# NOTE: VITE_* variables are injected at BUILD TIME.
#       After setting/editing VITE_API_URL in Render, trigger a Manual Deploy.
