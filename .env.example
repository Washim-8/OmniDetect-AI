# ===== Render Environment Variables Reference =====
#
# ---- Backend (Python Web Service: omnidetect-ai-backend) ----
# PORT=8000                                          # Set automatically by Render
# PYTHONPATH=.                                       # Python module resolution root
# MODEL_PATH=yolov8n.pt                              # Path to YOLO model weights
# PYTHONUNBUFFERED=1                                 # Real-time stdout logging
# CORS_ORIGINS=*                                     # Allowed origins (or https://<frontend-name>.onrender.com)
# CONFIDENCE_THRESHOLD=0.25                         # Object detection confidence threshold
# INPUT_SIZE=640                                    # Model input frame resolution (640x640)
# USE_HALF=false                                    # Use half-precision FP16 (true on CUDA GPU, false on CPU)
# USE_TTA=false                                     # Test-time augmentation (false for low latency)
#
# ---- Frontend (Static Site: omnidetect-ai-frontend) ----
# VITE_API_URL=https://<your-backend-name>.onrender.com
# NODE_VERSION=20.19.0
# NOTE: VITE_* variables are baked in at BUILD TIME by Vite.
#       When your backend service is deployed, copy its live URL and set VITE_API_URL in Render.
#       Then trigger a manual deploy for the frontend if updated.
